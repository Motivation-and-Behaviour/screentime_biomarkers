{
  "name": "Screen Time Biomarkers",
  "image": "ghcr.io/tarensanders/r-base:latest",
  "features": {
    "ghcr.io/rocker-org/devcontainer-features/r-packages:1": {
      "packages": "DT, flextable, github::crsh/prereg, github::crsh/papaja, github::conig/metaKIN, gittargets, lavaan, lme4, lmerTest, broom.mixed, parameters",
      "installSystemRequirements": true
    }
  },
  "mounts": [
    "source=/mnt/c/Users/TaSandersAdmin/OneDrive - Australian Catholic University/LSAC Data,target=/data,type=bind",
    "source=claude-code-config-${devcontainerId},target=/home/rstudio/.claude,type=volume"
  ],
  "postCreateCommand": "sudo chown -R rstudio:rstudio /home/rstudio/.claude"
}